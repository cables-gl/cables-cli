{
    "name": "@cables/cables",
    "version": "0.23.0",
    "description": "cables command line tool",
    "main": "index.js",
    "type": "module",
    "engines": {
        "node": "20.13.1"
    },
    "scripts": {
        "clean": "rimraf test/",
        "test": "run-s clean _test",
        "test:cli": "run-s clean _test:cli",
        "test:code": "run-s clean _test:code",
        "test:patch": "run-s clean _test:patch",
        "_test": "node test.js",
        "_test:cli": "node index.js -D -a all -d test/ -e FO9IG3",
        "_test:code": "node index.js -d test/js/ -C FO9IG3,lntUQx,TctR5r",
        "_test:patch": "node index.js -d test/ -p -e FO9IG3"
    },
    "bin": {
        "cables": "./index.js"
    },
    "author": "undev (https://undev.studio)",
    "homepage": "https://github.com/cables-gl/cables-cli",
    "bugs": {
        "url": "https://github.com/cables-gl/cables-cli/issues"
    },
    "keywords": [
        "visual-programming",
        "cables",
        "export"
    ],
    "license": "MIT",
    "dependencies": {
        "archiver": "7.0.1",
        "cables": "git://git@github.com:cables-gl/cables.git#develop",
        "cables_dev": "git://git@github.com:cables-gl/cables_dev.git#develop",
        "command-line-args": "6.0.1",
        "command-line-usage": "7.0.4",
        "extract-zip": "2.0.1",
        "ini": "5.0.0",
        "md5-file": "5.0.0",
        "prompt": "1.3.0",
        "glob": "13.0.6",
        "webpack": "5.106.2",
        "webpack-cli": "7.0.2",
        "terser-webpack-plugin": "5.5.0",
        "glsl-tokenizer": "2.1.5",
        "jsonfile": "6.2.1",
        "html-webpack-plugin": "5.6.7",
        "handlebars-loader": "1.7.3",
        "copy-webpack-plugin": "14.0.0",
        "cables-shared-client": "file:./node_modules/cables_dev/shared/client",
        "raw-loader": "4.0.2"
    },
    "devDependencies": {
        "npm-run-all": "4.1.5",
        "rimraf": "6.0.1"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/cables-gl/cables-cli.git"
    }
}
